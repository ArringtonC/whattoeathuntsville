---
import { visible } from '../../lib/data';
import { getCollection, getEntries, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import Label from '../../components/Label.astro';
import AdSlot from '../../components/AdSlot.astro';
import SignupBand from '../../components/SignupBand.astro';
import { fmtDate, guideAdSlots, mapsUrl, metaLine, priceText } from '../../lib/site';

export async function getStaticPaths() {
  return (await getCollection('guides', visible)).map((g) => ({ params: { slug: g.id }, props: { g } }));
}
const { g } = Astro.props;
const { Content } = await render(g);
const places = await getEntries(g.data.entries.map((e) => e.restaurant));
const entries = g.data.entries.map((e, i) => ({ ...e, r: places[i] })).filter((e) => e.r && e.r.data.status !== 'closed');
const adAfter = new Set(guideAdSlots(entries.length));
---
<Base title={g.data.seoTitle ?? g.data.title} description={g.data.seoDescription ?? g.data.dek}>
  <article class="narrow" style="padding-top: 40px; padding-bottom: 56px;">
    {g.data.sponsored && <p class="note" style="margin-bottom: 20px;"><span class="label label-sponsored">SPONSORED</span> This guide was paid for. Places on it were still chosen by us.</p>}
    <p class="kicker" style="margin-bottom: 12px;">Guide · {entries.length} places · Updated {fmtDate(g.data.updated)}</p>
    <h1 class="h1" style="margin-bottom: 16px;">{g.data.title}</h1>
    <div class="prose"><Content /></div>

    {entries.map((e, i) => (
      <>
        <section style="display: flex; flex-wrap: wrap; gap: 24px; padding: 32px 0; border-top: 1px solid var(--line);">
          <a href={`/restaurants/${e.r.id}`} style="flex: 0 0 200px; max-width: 100%;"><Cover id={e.r.id} src={e.r.data.cover} alt={e.r.data.name} focus={e.r.data.coverFocus}><Label label={e.r.data.label} /></Cover></a>
          <div style="flex: 1 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 8px;">
            <a href={`/restaurants/${e.r.id}`} style="font-size: 28px; font-weight: 800; letter-spacing: -0.02em; line-height: 1.05; text-decoration: none;">{e.r.data.name}</a>
            <span class="meta" style="font-size: 14px; font-weight: 600; color: var(--soft-text);">{metaLine(e.r.data.cuisines[0], e.r.data.area ?? e.r.data.city, priceText(e.r.data.price))}</span>
            <p class="serif" style="font-size: 19px; line-height: 1.5; color: var(--body);">{e.why}</p>
            {e.dish && <p><strong>Order:</strong> {e.dish}</p>}
            <a href={mapsUrl(e.r.data)} rel="noopener" style="font-weight: 700;">Directions</a>
          </div>
        </section>
        {adAfter.has(i + 1) && <AdSlot />}
      </>
    ))}

    <p class="note" style="margin-top: 24px;"><strong>Disclosure:</strong> No restaurant paid to be on this list. Ads on this page are labeled and do not affect it.</p>
  </article>
  <SignupBand heading="Liked this list? Get one pick every week." />
</Base>
