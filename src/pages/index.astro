---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import RestaurantCard from '../components/RestaurantCard.astro';
import Cover from '../components/Cover.astro';
import LabelKey from '../components/LabelKey.astro';
import SignupBand from '../components/SignupBand.astro';
import { guideCover, listedRestaurants, visible } from '../lib/data';
import { CUISINES, LOCAL_CITIES, SITE, TRAVEL_CITIES, slugify, toneFor } from '../lib/site';

const restaurants = await listedRestaurants();
const local = restaurants.filter((r) => LOCAL_CITIES.includes(r.data.city));
const newFinds = [...local].sort((a, b) => +b.data.lastVerified - +a.data.lastVerified || Number(b.data.featured) - Number(a.data.featured)).slice(0, 4);
const greatUrls = local.filter((r) => r.data.label === 'great').map((r) => `/restaurants/${r.id}`);
// Biggest cuisines first. Circle photos are stock photos in public/cuisines (see SOURCES.txt there).
const cuisines = CUISINES.map((c) => ({ name: c, count: local.filter((r) => r.data.cuisines.includes(c)).length }))
  .filter((c) => c.count > 0).sort((a, b) => b.count - a.count).slice(0, 12)
  .map((c) => ({ ...c, cover: `/cuisines/${slugify(c.name)}.jpg` }));
const guides = await Promise.all((await getCollection('guides', visible)).slice(0, 3).map(async (g) => ({ ...g, cover: await guideCover(g) })));
const outside = restaurants.filter((r) => TRAVEL_CITIES.includes(r.data.city)).slice(0, 4);
const cravings = ['Tacos', 'Brunch', 'Burgers', 'Pizza', 'BBQ', 'Sweet treats', 'Date night', 'Cheap eats'];
---
<Base>
  <section class="band-cream">
    <div class="wrap section" style="display: flex; flex-wrap: wrap; gap: 48px; align-items: center;">
      <div style="flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 22px;">
        <p class="kicker">{SITE.tagline}</p>
        <h1 class="h1">What to eat in <span class="serif" style="font-style: italic; font-weight: 500; color: var(--red);">Huntsville</span></h1>
        <p class="dek" style="max-width: 520px;">What are you craving? Honest picks from two local food lovers. We tell you what's good, what's great, and exactly what to order.</p>
        <form class="search" role="search" action="/restaurants">
          <label class="q"><span class="sr-only">Search food or restaurants</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6B6259" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
            <input type="search" name="q" placeholder="Tacos, brunch, a restaurant name…" />
          </label>
          <label><span class="sr-only">Location</span><select name="city"><option value="">Anywhere</option>{LOCAL_CITIES.map((c) => <option selected={c === 'Huntsville'}>{c}</option>)}</select></label>
          <button class="btn btn-red" type="submit" style="min-height: 52px;">Find food</button>
        </form>
        <a class="link-strong" href="/what-to-eat-in-huntsville/" style="align-self: flex-start;">New here? Start with our guide to what to eat in Huntsville</a>
        <div style="display: flex; flex-wrap: wrap; gap: 8px;">
          {cravings.map((c) => <a class="chip" href={`/restaurants?q=${encodeURIComponent(c)}`}>{c}</a>)}
        </div>
        {greatUrls.length > 0 && (
          <button id="surprise" class="btn" type="button" style="align-self: flex-start; border-color: var(--green); color: var(--green);" data-urls={JSON.stringify(greatUrls)}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h3l9 10h6"/><path d="M18 14l3 3-3 3"/><path d="M3 17h3l2.5-2.8"/><path d="M13.5 9.8L15 7h6"/><path d="M18 4l3 3-3 3"/></svg>
            Not sure? Show me something good
          </button>
        )}
      </div>
    </div>
  </section>

  <SignupBand />

  <section class="wrap section">
    <div class="row-head">
      <div><p class="kicker" style="margin-bottom: 8px;">Fresh from our TikTok</p><h2 class="h2">New finds</h2><div style="margin-top: 12px;"><LabelKey /></div></div>
      <a class="link-strong" href="/restaurants">See all restaurants</a>
    </div>
    <div class="grid">{newFinds.map((r) => <RestaurantCard r={r} />)}</div>
  </section>

  <section class="band-cream">
    <div class="wrap" style="padding-top: 40px; padding-bottom: 40px; display: flex; flex-wrap: wrap; gap: 20px 40px; align-items: center; justify-content: space-between;">
      <div style="flex: 1 1 420px; display: flex; flex-direction: column; gap: 8px;">
        <p class="kicker">For restaurants &amp; brands</p>
        <h2 class="h2">Work with What to Eat Huntsville</h2>
        <p style="color: var(--muted);">Almost 1 million TikTok views a year from Huntsville food lovers. Sponsored visits, newsletter features, and photo and video work.</p>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 10px;">
        <a class="btn btn-red" href="/work-with-us/">Work with us</a>
        <a class="btn" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
    </div>
  </section>

  {cuisines.length > 0 && (
    <section class="wrap section">
      <h2 style="font-size: 30px; font-weight: 800; margin-bottom: 20px;">Browse by cuisine</h2>
      <div class="circles">
        {cuisines.map((c) => (
          <a href={`/restaurants/cuisine/${slugify(c.name)}`}>
            <span class="circle" style={`background: ${toneFor(c.name)};`}>{c.cover && <img src={c.cover} alt={`${c.name} food`} loading="lazy" />}</span>
            <b>{c.name}</b>
            <small>{c.count} {c.count === 1 ? 'spot' : 'spots'}</small>
          </a>
        ))}
      </div>
    </section>
  )}

  {outside.length > 0 && (
    <section class="band-cream">
      <div class="wrap section">
        <div class="row-head">
          <div><p class="kicker" style="margin-bottom: 8px;">Outside Huntsville</p><h2 class="h2">Worth the drive</h2></div>
          <a class="link-strong" href="/travel">See all outside Huntsville</a>
        </div>
        <div class="grid">{outside.map((r) => <RestaurantCard r={r} />)}</div>
      </div>
    </section>
  )}

  <section class="band-ink">
    <div class="wrap section">
      <div class="row-head">
        <div><p class="kicker" style="color: #F2A7A9; margin-bottom: 8px;">Guides</p><h2 class="h2">Lists we'd send <span class="serif" style="font-style: italic; font-weight: 500;">a friend</span></h2></div>
        <a class="link-strong" href="/guides">All guides</a>
      </div>
      <div class="grid" style="grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));">
        {guides.map((g) => (
          <a class="card" href={`/guides/${g.id}`} style="color: #fff;">
            <Cover id={g.id} src={g.cover} alt={g.data.title} ratio="3 / 2" play={false} />
            <span class="kicker" style="color: #F2A7A9;">Guide · {g.data.entries.length} places</span>
            <span class="name" style="font-size: 26px;">{g.data.title}</span>
            <span class="serif" style="color: #D8D0C6; font-size: 17px;">{g.data.dek}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap section" style="display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; justify-content: space-between;">
    <h2 style="font-size: 30px; font-weight: 800;">See it all on TikTok</h2>
    <a class="btn" href={SITE.tiktok} rel="noopener">@whattoeathuntsville on TikTok</a>
  </section>

  <script>
    const btn = document.getElementById('surprise');
    btn?.addEventListener('click', () => {
      const urls: string[] = JSON.parse(btn.dataset.urls ?? '[]');
      if (urls.length) location.href = urls[Math.floor(Math.random() * urls.length)];
    });
  </script>
</Base>
