---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="narrow section" style="display: flex; flex-direction: column; gap: 18px;">
    <p class="kicker">404</p>
    <h1 class="h1">That page is not on the menu.</h1>
    <p class="dek">It may have moved, or the restaurant may have closed. Try a search instead.</p>
    <form class="search" role="search" action="/restaurants">
      <label class="q"><span class="sr-only">Search food or restaurants</span><input type="search" name="q" placeholder="Tacos, brunch, a restaurant name…" /></label>
      <button class="btn btn-red" type="submit" style="min-height: 52px;">Find food</button>
    </form>
  </section>
</Base>
