---
// Link-in-bio page for TikTok and Instagram (replaces Linktree).
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';

const main = [
  ['Find food in Huntsville', '/restaurants/'],
  ['What to eat in Huntsville: our guide', '/what-to-eat-in-huntsville/'],
  [`Get our weekly pick (${SITE.newsletter}, free)`, '/newsletter/'],
  ['What should we eat next?', '/eat-next/'],
  ['Suggest a spot', '/suggest/'],
  ['Work with us', '/work-with-us/'],
];
const social = [
  ['TikTok', SITE.tiktok],
  ['Instagram', SITE.instagram],
  ['YouTube', SITE.youtube],
  ['Facebook', SITE.facebook],
  ['Trips with M on TikTok', 'https://www.tiktok.com/@tripswithm'],
  ['Trips with M on YouTube', 'https://youtube.com/@tripswithm'],
];
---
<Base title="Links" description="All the What to Eat Huntsville links in one place: restaurants, guides, the newsletter, and our socials.">
  <section class="band-cream" style="min-height: 100%;">
    <div class="section" style="max-width: 480px; margin: 0 auto; padding-left: var(--gutter); padding-right: var(--gutter); display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center;">
      <img src="/logo.jpg" alt={SITE.name} width="96" height="96" style="width: 96px; height: 96px; border-radius: 24px;" />
      <h1 style="font-size: 26px; font-weight: 800;">{SITE.name}</h1>
      <p style="color: var(--muted);">Honest restaurant picks in Huntsville, Alabama, plus travel eats.</p>
      {main.map(([label, href], i) => <a class={i === 0 ? 'btn btn-red' : 'btn'} href={href} style="width: 100%; min-height: 56px;">{label}</a>)}
      <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 16px; margin-top: 10px;">
        {social.map(([label, href]) => <a href={href} rel="noopener" style="font-weight: 700;">{label}</a>)}
      </div>
    </div>
  </section>
</Base>
