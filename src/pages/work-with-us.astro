---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site';
import Label from '../components/Label.astro';

const offers = [
  ['Website', 'Website Sponsor', 'A labeled feature card on the homepage or in Find Food results, linked to your page or offer.'],
  ['Newsletter', 'Spot in The Weekly Bite', 'A labeled sponsor block inside our Thursday email. Our pick of the week stays independent.'],
  ['Email', 'A Local Spotlight', 'A whole email about your business, sent to readers who opted in to partner features. At most one a month.'],
  ['TikTok + site', 'Restaurant Promotion', 'A sponsored TikTok video, a labeled feature on the site, and the clips for your own use.'],
  ['Events', 'Event coverage & giveaways', 'We cover your opening, festival, or event on TikTok and Instagram, with an optional labeled giveaway.'],
  ['Services', 'Social media help', 'Content creation, strategy, and short-form video for your own accounts. No posting on ours required.'],
];
const steps = [
  ['Inquiry', 'You fill out the form below.'],
  ['Quick call', 'We talk goals, timing, and fit.'],
  ['Proposal', 'You get a plan and a price.'],
  ['Create', 'We make it. You approve facts and offers.'],
  ['Report', 'You see views, clicks, and visits after it runs.'],
];
const interests = ['Website feature', 'Spot in The Weekly Bite', 'A Local Spotlight email', 'Sponsored TikTok video', 'Event coverage or giveaway', 'Social media help for my business'];
---
<Base title="Work with us" description="Sponsored features, newsletter placements, and photo and video work for Huntsville businesses.">
  <section class="band-ink">
    <div class="wrap section" style="display: flex; flex-wrap: wrap; gap: 44px; align-items: center;">
      <div style="flex: 1 1 520px; display: flex; flex-direction: column; gap: 18px;">
        <p class="kicker" style="color: #F2A7A9;">Work with us</p>
        <h1 class="h1">Reach people deciding where to eat in Huntsville.</h1>
        <p class="dek" style="color: #D8D0C6;">Restaurant features, event coverage, sponsored posts, newsletter placements, and social media help for local businesses. Paid work is always clearly labeled.</p>
        <a class="btn btn-red" href="#inquiry" style="align-self: flex-start;">Start an inquiry</a>
      </div>
      <div style="flex: 1 1 340px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px;">
        <div style="border: 1px solid #3A332C; border-radius: 18px; padding: 20px;"><b style="font-size: 36px;">17.5K</b><br /><span style="color: #D8D0C6; font-size: 14px;">TikTok followers</span></div>
        <div style="border: 1px solid #3A332C; border-radius: 18px; padding: 20px;"><b style="font-size: 36px;">185K</b><br /><span style="color: #D8D0C6; font-size: 14px;">TikTok likes</span></div>
        <p style="grid-column: span 2; font-size: 12px; color: #B9AE9F;">As of Oct 2026. Website and email numbers will be added once we have real data.</p>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <h2 class="h2" style="margin-bottom: 8px;">Ways to work together</h2>
    <p class="dek" style="margin-bottom: 28px;">Pricing depends on timing and size. Ask for a quote.</p>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px;">
      {offers.map(([kind, name, what]) => (
        <div class="box" style="display: flex; flex-direction: column; gap: 10px;">
          <span class="kicker" style="font-size: 11px;">{kind}</span>
          <h3 style="font-size: 23px; font-weight: 800;">{name}</h3>
          <p style="color: var(--muted); line-height: 1.5;">{what}</p>
          <span style="margin-top: auto; font-weight: 700; font-size: 14px;">Price on request</span>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap" style="padding-bottom: 48px;">
    <div class="band-cream" style="border-radius: 22px; padding: 28px; display: flex; flex-wrap: wrap; gap: 28px;">
      <div style="flex: 1 1 280px;"><h2 style="font-size: 28px; font-weight: 800;">What we never sell</h2><p style="color: var(--muted); margin-top: 8px;">This is why our audience trusts us, and why your feature works.</p></div>
      <ul style="flex: 2 1 420px; margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; font-size: 17px;">
        <li style="display: flex; flex-wrap: wrap; gap: 8px; align-items: center;"><Label label="great" /><Label label="good" /> labels, or a better rating</li>
        <li>A place in our guides, or a higher spot in search results</li>
        <li>Unlabeled posts. Paid content always says <strong>Sponsored</strong>.</li>
        <li style="padding-top: 10px; border-top: 1px solid var(--line);">Paid campaigns can use a <strong>"Featured on What to Eat Huntsville"</strong> badge. Only earned picks get the Great badge.</li>
      </ul>
    </div>
  </section>

  <section class="wrap" style="padding-bottom: 56px;">
    <h2 class="h2" style="margin-bottom: 22px;">How it works</h2>
    <ol style="margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 18px;">
      {steps.map(([t, d], i) => <li style="border-top: 3px solid var(--ink); padding-top: 12px; display: flex; flex-direction: column; gap: 6px;"><span style="color: var(--red); font-weight: 800;">0{i + 1}</span><strong style="font-size: 19px;">{t}</strong><span style="color: var(--muted);">{d}</span></li>)}
    </ol>
  </section>

  <section id="inquiry" class="band-cream">
    <div class="wrap section" style="display: flex; flex-wrap: wrap; gap: 48px; align-items: flex-start;">
      <div style="flex: 1 1 320px; display: flex; flex-direction: column; gap: 12px;">
        <h2 class="h2">Tell us about your idea</h2>
        <p class="dek">We reply within a few business days.</p>
      </div>
      <p id="thanks" hidden class="box" style="flex: 2 1 520px; background: #fff; font-size: 20px; font-weight: 700;">Thanks! We got your inquiry and will reply soon.</p>
      <form id="inquiry-form" method="POST" data-send data-thanks="thanks" action={SITE.formEndpoint} style="flex: 2 1 520px; background: #fff; border: 1px solid var(--line); border-radius: 22px; padding: 28px; display: flex; flex-direction: column; gap: 18px;">
        <input type="hidden" name="_subject" value="New business inquiry" />
        <p hidden><label>Leave this empty <input name="_honey" tabindex="-1" autocomplete="off" /></label></p>
        <div style="display: flex; flex-wrap: wrap; gap: 16px;">
          <label class="field" style="flex: 1 1 220px;">Your name<input class="input" name="name" required autocomplete="name" /></label>
          <label class="field" style="flex: 1 1 220px;">Business name<input class="input" name="business" required autocomplete="organization" /></label>
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: 16px;">
          <label class="field" style="flex: 1 1 220px;">Email<input class="input" type="email" name="email" required autocomplete="email" /></label>
          <label class="field" style="flex: 1 1 220px;">Type of business<select class="input" name="type"><option>Restaurant or food business</option><option>Event or festival</option><option>Tourism or travel</option><option>Local brand or shop</option><option>Other</option></select></label>
        </div>
        <fieldset style="border: 0; padding: 0; margin: 0;">
          <legend style="font-weight: 700; margin-bottom: 6px;">Interested in</legend>
          <div style="display: flex; flex-wrap: wrap; gap: 0 22px;">{interests.map((x) => <label class="check"><input type="checkbox" name="interests" value={x} /> {x}</label>)}</div>
        </fieldset>
        <div style="display: flex; flex-wrap: wrap; gap: 16px;">
          <label class="field" style="flex: 1 1 220px;">Timing<select class="input" name="timing"><option>In the next month</option><option>1–3 months</option><option>Just exploring</option></select></label>
        </div>
        <label class="field">What do you have in mind?<textarea class="input" name="message" rows="4"></textarea></label>
        <p style="font-size: 13px; color: var(--muted);">All paid work is labeled "Sponsored" and does not change our Good or Great labels.</p>
        <button class="btn btn-red" type="submit" style="align-self: flex-start; min-height: 56px;">Send inquiry</button>
      </form>
    </div>
  </section>
</Base>
