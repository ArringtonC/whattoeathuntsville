---
import type { CollectionEntry } from 'astro:content';
import Cover from './Cover.astro';
import Label from './Label.astro';
import { metaLine, priceText } from '../lib/site';
interface Props { r: CollectionEntry<'restaurants'> }
const { r } = Astro.props;
const d = r.data;
---
<a class="card" href={`/restaurants/${r.id}`}
  data-name={d.name.toLowerCase()} data-city={d.city} data-cuisines={d.cuisines.join('|')} data-price={d.price}
  data-label={d.label} data-occasions={d.occasions.join('|')}
  data-search={[d.name, d.area, d.city, ...d.cuisines, ...d.occasions, d.bestDish?.name].filter(Boolean).join(' ').toLowerCase()}
  data-verified={d.lastVerified.toISOString()}>
  <Cover id={r.id} src={d.cover} alt={d.name} focus={d.coverFocus}><Label label={d.label} /></Cover>
  <span class="meta">{metaLine(d.cuisines[0], d.area ?? d.city, priceText(d.price))}</span>
  <span class="name">{d.name}</span>
  {d.bestDish && <span class="order">Order: <em>{d.bestDish.name}</em></span>}
</a>
