---
import '../styles/global.css';
import { SITE } from '../lib/site';

interface Props { title?: string; description?: string; image?: string }
const { title, description = 'Honest restaurant picks in Huntsville, Madison, and beyond. What to order and where to go.', image } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · What to eat this week`;
const path = Astro.url.pathname;
const nav = [
  ['/restaurants', 'Find Food'],
  ['/guides', 'Guides & Stories'],
  ['/travel', 'Outside Huntsville'],
  ['/about', 'About'],
];
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
// Public preview: drafts are shown, so keep it out of search engines and switch off forms.
const preview = import.meta.env.PUBLIC_SHOW_DRAFTS === 'true';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={new URL(path, Astro.site)} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image ?? '/logo.jpg', Astro.site)} />
<link rel="icon" href="/logo.jpg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..600&display=swap" rel="stylesheet" />
{preview && <meta name="robots" content="noindex, nofollow" />}
<slot name="head" />
</head>
<body>
{preview && <div style="background: var(--ink); color: #fff; font-size: 13px; font-weight: 600; text-align: center; padding: 8px 16px;">Preview · Our Great and Good labels are coming soon · Forms open at launch</div>}
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">
      <img src="/logo.jpg" alt="" width="52" height="52" />
      <span><b>What to Eat</b><small>HUNTSVILLE</small></span>
    </a>
    <nav class="nav" aria-label="Main">
      {nav.map(([href, label]) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}
    </nav>
    <details class="menu">
      <summary aria-label="Open menu"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></summary>
      <nav aria-label="Main">
        {nav.map(([href, label]) => <a href={href}>{label}</a>)}
        <a href="/newsletter">{SITE.newsletter}</a>
      </nav>
    </details>
  </div>
</header>

<main><slot /></main>

<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <div style="max-width: 360px; display: flex; flex-direction: column; gap: 8px;">
        <strong style="font-size: 20px;">{SITE.name}</strong>
        <span class="serif" style="color: var(--soft-text); font-size: 17px;">Honest restaurant picks in North Alabama and beyond. We pay for our own meals unless a post says otherwise.</span>
      </div>
      <nav aria-label="Footer">
        <div><strong>Explore</strong><a href="/restaurants">Find Food</a><a href="/guides">Guides &amp; Stories</a><a href="/travel">Outside Huntsville</a></div>
        <div><strong>About</strong><a href="/about">Our story</a><a href="/about#standards">Editorial standards</a><a href="/work-with-us">Work with us</a></div>
        <div><strong>Follow</strong><a href={SITE.tiktok}>TikTok</a><a href={SITE.instagram}>Instagram</a><a href={SITE.facebook}>Facebook</a><a href="/newsletter">{SITE.newsletter}</a><a href="/suggest">Suggest a spot</a></div>
      </nav>
    </div>
    <div class="legal"><span>© {new Date().getFullYear()} {SITE.name}</span><a href="/privacy">Privacy</a><a href="/disclosures">Disclosures</a></div>
  </div>
</footer>
<slot name="after" />
<script is:inline>
  // Kit sign-up forms: send in the background so people stay on our page.
  document.addEventListener('submit', async (e) => {
    const f = e.target;
    if (!f.hasAttribute('data-kit')) return;
    e.preventDefault();
    const btn = f.querySelector('button'); if (btn) btn.disabled = true;
    let ok = false;
    try {
      const res = await fetch(f.action, { method: 'POST', body: new FormData(f), headers: { Accept: 'application/json' } });
      ok = res.ok && (await res.json()).status === 'success';
    } catch {}
    if (btn) btn.disabled = false;
    const p = f.querySelector('.kit-msg') || f.appendChild(Object.assign(document.createElement('p'), { className: 'kit-msg' }));
    p.setAttribute('role', 'status');
    p.style.cssText = 'margin-top: 8px; font-weight: 700;';
    p.textContent = ok ? "You're in. Check your inbox to confirm your email." : 'That did not go through. Check your email address and try again.';
    if (ok) f.reset();
  });
</script>
{preview && <script is:inline>
  document.addEventListener('submit', (e) => {
    const f = e.target;
    if ((f.method || '').toLowerCase() !== 'post' || f.hasAttribute('data-kit')) return;
    e.preventDefault();
    const p = document.createElement('p');
    p.textContent = 'Preview: this form opens at launch.';
    p.style.cssText = 'margin-top: 8px; font-weight: 700;';
    f.appendChild(p);
  }, true);
</script>}
</body>
</html>
