---
import '../styles/global.css';
import { ADSENSE_CLIENT, SITE } from '../lib/site';

interface Props { title?: string; description?: string; image?: string; noindex?: boolean }
const { title, description = 'What to eat in Huntsville, AL: honest restaurant picks from two locals, with what to order at each spot in Huntsville, Madison and nearby.', image, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : 'What to Eat in Huntsville, AL · Local Food Picks';
const path = Astro.url.pathname;
const nav = [
  ['/restaurants', 'Find Food'],
  ['/guides', 'Guides'],
  ['/eat-next', 'Eat Next'],
  ['/travel', 'Outside Huntsville'],
  ['/about', 'About'],
  ['/work-with-us', 'Work With Us'],
];
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
// Public preview: drafts are shown, so keep it out of search engines and switch off forms.
const preview = import.meta.env.PUBLIC_SHOW_DRAFTS === 'true';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={new URL(path, Astro.site)} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image ?? '/logo.jpg', Astro.site)} />
<!-- Google search shows a square icon that is a multiple of 48px; /favicon.ico is also its fallback -->
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..600&display=swap" rel="stylesheet" />
{(preview || noindex) && <meta name="robots" content={preview ? 'noindex, nofollow' : 'noindex, follow'} />}
<slot name="head" />
<script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous"></script>
</head>
<body>
{preview && <div style="background: var(--ink); color: #fff; font-size: 13px; font-weight: 600; text-align: center; padding: 8px 16px;">Preview · Our Great and Good labels are coming soon · Forms open at launch</div>}
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">
      <img src="/logo.jpg" alt="" width="52" height="52" />
      <span><b>What to Eat</b><small>HUNTSVILLE</small></span>
    </a>
    <nav class="nav" aria-label="Main">
      {nav.map(([href, label]) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>)}
    </nav>
    <details class="menu">
      <summary aria-label="Open menu"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></summary>
      <nav aria-label="Main">
        {nav.map(([href, label]) => <a href={href}>{label}</a>)}
        <a href="/newsletter">{SITE.newsletter}</a>
      </nav>
    </details>
  </div>
</header>

<main><slot /></main>

<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <div style="max-width: 360px; display: flex; flex-direction: column; gap: 8px;">
        <strong style="font-size: 20px;">{SITE.name}</strong>
        <span class="serif" style="color: var(--soft-text); font-size: 17px;">Honest restaurant picks in North Alabama and beyond. We pay for our own meals unless a post says otherwise.</span>
      </div>
      <nav aria-label="Footer">
        <div><strong>Explore</strong><a href="/restaurants">Find Food</a><a href="/guides">Guides</a><a href="/travel">Outside Huntsville</a></div>
        <div><strong>About</strong><a href="/about">Our story</a><a href="/about#standards">Editorial standards</a><a href="/work-with-us">Work with us</a></div>
        <div><strong>Follow</strong><a href={SITE.tiktok}>TikTok</a><a href={SITE.instagram}>Instagram</a><a href={SITE.youtube}>YouTube</a><a href={SITE.facebook}>Facebook</a><a href="/newsletter">{SITE.newsletter}</a><a href="/suggest">Suggest a spot</a><a href={`mailto:${SITE.email}`}>Email us</a></div>
      </nav>
    </div>
    <div class="legal"><span>© {new Date().getFullYear()} {SITE.name}</span><a href="/privacy">Privacy</a><a href="/disclosures">Disclosures</a></div>
  </div>
</footer>
<slot name="after" />
<script is:inline>
  // Kit sign-ups (data-kit) and FormSubmit forms (data-send): send in the background so people stay on our page.
  document.addEventListener('submit', async (e) => {
    const f = e.target;
    const kit = f.hasAttribute('data-kit');
    if (!kit && !f.hasAttribute('data-send')) return;
    e.preventDefault();
    const btn = f.querySelector('button[type="submit"], button:not([type])'); if (btn) btn.disabled = true;
    let ok = false;
    try {
      const res = await fetch(f.action, { method: 'POST', body: new FormData(f), headers: { Accept: 'application/json' } });
      const j = await res.json();
      ok = res.ok && (kit ? j.status === 'success' : String(j.success) === 'true');
    } catch {}
    if (btn) btn.disabled = false;
    const thanks = f.dataset.thanks && document.getElementById(f.dataset.thanks);
    if (ok && thanks) { f.hidden = true; thanks.hidden = false; return; }
    const p = f.querySelector('.kit-msg') || f.appendChild(Object.assign(document.createElement('p'), { className: 'kit-msg' }));
    p.setAttribute('role', 'status');
    p.style.cssText = 'margin-top: 8px; font-weight: 700;';
    p.textContent = ok ? "You're in! Your first pick arrives Thursday. Not in your inbox? Check spam and mark it \"Not spam.\"" : (kit ? 'That did not go through. Please check the form and try again.' : 'That did not go through. Please email us at ' + 'hello@whattoeathuntsville.com and we will get back to you.');
    if (ok) f.reset();
  });
</script>
{preview && <script is:inline>
  document.addEventListener('submit', (e) => {
    const f = e.target;
    if ((f.method || '').toLowerCase() !== 'post' || f.hasAttribute('data-kit') || f.hasAttribute('data-send')) return;
    e.preventDefault();
    const p = document.createElement('p');
    p.textContent = 'Preview: this form opens at launch.';
    p.style.cssText = 'margin-top: 8px; font-weight: 700;';
    f.appendChild(p);
  }, true);
</script>}
<!-- Cloudflare Web Analytics: counts visits, no cookies. -->
<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "7746d9356b17475dbdce2a33207272f1"}'></script>
</body>
</html>
